@prefix hosp: <http://hospitality.example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://hospitality.example.org/instance/product/prod_bev_001> a hosp:Product ;
    rdfs:label "Fresh Ground Coffee — Latte (whole bean + milk)" ;
    hosp:category "HOT DRINKS" ;
    hosp:contractedPriceGBP 2.1 ;
    hosp:eposItemId "EPOS-LATTE" ;
    hosp:procProductId "PROD-BEV-001" ;
    hosp:productName "Fresh Ground Coffee — Latte (whole bean + milk)" .

<http://hospitality.example.org/instance/product/prod_bev_002> a hosp:Product ;
    rdfs:label "Fresh Ground Coffee — Americano (whole bean)" ;
    hosp:category "HOT DRINKS" ;
    hosp:contractedPriceGBP 1.85 ;
    hosp:eposItemId "EPOS-AMERI" ;
    hosp:procProductId "PROD-BEV-002" ;
    hosp:productName "Fresh Ground Coffee — Americano (whole bean)" .

<http://hospitality.example.org/instance/product/prod_bev_003> a hosp:Product ;
    rdfs:label "Tetley English Breakfast Tea — box 100" ;
    hosp:category "HOT DRINKS" ;
    hosp:contractedPriceGBP 0.35 ;
    hosp:eposItemId "EPOS-TEA" ;
    hosp:procProductId "PROD-BEV-003" ;
    hosp:productName "Tetley English Breakfast Tea — box 100" .

