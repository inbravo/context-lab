    hosp:productName "Chicken Curry & Basmati Rice — portion" .

<http://hospitality.example.org/instance/product/prod_main_002> a hosp:Product ;
    rdfs:label "Pasta Bolognese — hot counter portion" ;
    hosp:category "MAINS" ;
    hosp:contractedPriceGBP 3.5 ;
    hosp:eposItemId "EPOS-PASTA" ;
    hosp:procProductId "PROD-MAIN-002" ;
    hosp:productName "Pasta Bolognese — hot counter portion" .

<http://hospitality.example.org/instance/product/prod_main_003> a hosp:Product ;
    rdfs:label "Vegetable Tagine — hot counter portion" ;
    hosp:category "MAINS" ;
