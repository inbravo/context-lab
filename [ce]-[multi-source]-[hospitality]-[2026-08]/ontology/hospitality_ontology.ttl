    hosp:eposItemId "EPOS-VTAG" ;
    hosp:procProductId "PROD-MAIN-003" ;
    hosp:productName "Vegetable Tagine — hot counter portion" .

<http://hospitality.example.org/instance/product/prod_sand_001> a hosp:Product ;
    rdfs:label "BLT Sandwich — chilled, pre-packed" ;
