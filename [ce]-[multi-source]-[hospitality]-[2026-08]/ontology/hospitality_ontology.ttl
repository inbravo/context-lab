    hosp:contractedPriceGBP 2.8 ;
    hosp:eposItemId "EPOS-BLTSD" ;
    hosp:procProductId "PROD-SAND-001" ;
    hosp:productName "BLT Sandwich — chilled, pre-packed" .

<http://hospitality.example.org/instance/product/prod_sand_002> a hosp:Product ;
    rdfs:label "Chicken Tikka Wrap — chilled, pre-packed" ;
    hosp:category "SANDWICHES" ;
    hosp:contractedPriceGBP 2.9 ;
    hosp:eposItemId "EPOS-CKWRP" ;
    hosp:procProductId "PROD-SAND-002" ;
    hosp:productName "Chicken Tikka Wrap — chilled, pre-packed" .

<http://hospitality.example.org/instance/site/gbr-lnd-01> a hosp:HospitalitySite ;
    rdfs:label "London Canary Wharf" ;
    hosp:eposSiteId "SITE-LDN-01" ;
    hosp:inforSiteCode "GBR_SITE_0001" ;
    hosp:sapCostCenter "CC-GBR-001" ;
    hosp:sfOrgUnitId "OU-GBR-001" ;
    hosp:siteName "London Canary Wharf" .

<http://hospitality.example.org/instance/site/gbr-lnd-02> a hosp:HospitalitySite ;
    rdfs:label "London City" ;
    hosp:eposSiteId "SITE-LDN-02" ;
    hosp:inforSiteCode "GBR_SITE_0002" ;
    hosp:sapCostCenter "CC-GBR-002" ;
    hosp:sfOrgUnitId "OU-GBR-002" ;
    hosp:siteName "London City" .

<http://hospitality.example.org/instance/site/gbr-man-01> a hosp:HospitalitySite ;
    rdfs:label "Manchester" ;
    hosp:eposSiteId "SITE-MAN-01" ;
    hosp:inforSiteCode "GBR_SITE_0101" ;
    hosp:sapCostCenter "CC-GBR-101" ;
    hosp:sfOrgUnitId "OU-GBR-101" ;
    hosp:siteName "Manchester" .

hosp:category a owl:DatatypeProperty ;
    rdfs:comment "Product category" ;
    rdfs:domain hosp:Product ;
    rdfs:range xsd:string .

hosp:contractedPriceGBP a owl:DatatypeProperty ;
    rdfs:comment "Coupa frame contract price per unit (GBP)" ;
    rdfs:domain hosp:Product ;
    rdfs:range xsd:decimal .

hosp:eposItemId a owl:DatatypeProperty ;
    rdfs:comment "Item code as used in Oracle MICROS EPOS (format: EPOS-LATTE)" ;
    rdfs:domain hosp:Product ;
    rdfs:range xsd:string .

hosp:eposSiteId a owl:DatatypeProperty ;
    rdfs:comment "site_id as recorded by Oracle MICROS EPOS (format: SITE-LDN-01)" ;
    rdfs:domain hosp:HospitalitySite ;
    rdfs:range xsd:string .

hosp:hasHRRecord a owl:ObjectProperty ;
    rdfs:comment "SuccessFactors employee records in this org unit" ;
    rdfs:domain hosp:HospitalitySite ;
    rdfs:range hosp:HRRecord .

hosp:hasSAPInvoice a owl:ObjectProperty ;
    rdfs:comment "SAP client invoices raised against this cost centre" ;
    rdfs:domain hosp:HospitalitySite ;
    rdfs:range hosp:SAPInvoice .

hosp:hasShift a owl:ObjectProperty ;
    rdfs:comment "Infor WFM shifts worked at this site" ;
    rdfs:domain hosp:HospitalitySite ;
    rdfs:range hosp:Shift .

hosp:hasTransaction a owl:ObjectProperty ;
    rdfs:comment "EPOS transactions at this site" ;
    rdfs:domain hosp:HospitalitySite ;
    rdfs:range hosp:Transaction .

hosp:inforSiteCode a owl:DatatypeProperty ;
    rdfs:comment "site_id as recorded by Infor WFM (format: GBR_SITE_0001) — country-prefixed with underscore" ;
    rdfs:domain hosp:HospitalitySite ;
    rdfs:range xsd:string .

hosp:procProductId a owl:DatatypeProperty ;
    rdfs:comment "Product SKU in the Coupa procurement catalogue (format: PROD-BEV-001)" ;
    rdfs:domain hosp:Product ;
    rdfs:range xsd:string .

hosp:productName a owl:DatatypeProperty ;
    rdfs:comment "Canonical product description" ;
    rdfs:domain hosp:Product ;
    rdfs:range xsd:string .

hosp:sapCostCenter a owl:DatatypeProperty ;
    rdfs:comment "cost_center_code as recorded by SAP S/4HANA (format: CC-GBR-001) — ERP cost centre" ;
    rdfs:domain hosp:HospitalitySite ;
    rdfs:range xsd:string .

hosp:sfOrgUnitId a owl:DatatypeProperty ;
    rdfs:comment "org_unit_id as recorded by SAP SuccessFactors (format: OU-GBR-001) — HR org unit" ;
    rdfs:domain hosp:HospitalitySite ;
    rdfs:range xsd:string .

hosp:siteName a owl:DatatypeProperty ;
    rdfs:comment "Human-readable site name" ;
    rdfs:domain hosp:HospitalitySite ;
    rdfs:range xsd:string .

hosp:soldItem a owl:ObjectProperty ;
    rdfs:comment "Product sold in this EPOS transaction" ;
    rdfs:domain hosp:Transaction ;
    rdfs:range hosp:Product .

hosp:suppliedBy a owl:ObjectProperty ;
    rdfs:comment "Coupa supplier for this product" ;
    rdfs:domain hosp:Product ;
    rdfs:range hosp:Supplier .

hosp:workedBy a owl:ObjectProperty ;
    rdfs:comment "Employee who worked this shift (WFM to SF identity gap)" ;
    rdfs:domain hosp:Shift ;
    rdfs:range hosp:Employee .

hosp:Employee a owl:Class ;
    rdfs:label "Employee" ;
    rdfs:comment "A workforce member — permanent, part-time, zero-hours, or agency" .

hosp:HRRecord a owl:Class ;
    rdfs:label "HRRecord" ;
    rdfs:comment "An employee HR & payroll record in SAP SuccessFactors" .

hosp:SAPInvoice a owl:Class ;
    rdfs:label "SAPInvoice" ;
    rdfs:comment "A client invoice generated by SAP S/4HANA for catering services" .

hosp:Supplier a owl:Class ;
    rdfs:label "Supplier" ;
    rdfs:comment "A supplier in the Coupa national procurement catalogue" .

hosp:Shift a owl:Class ;
    rdfs:label "Shift" ;
    rdfs:comment "A worked shift recorded by Infor WFM" .

hosp:Transaction a owl:Class ;
    rdfs:label "Transaction" ;
    rdfs:comment "A point-of-sale transaction recorded by the EPOS system (Oracle MICROS)" .

hosp:HospitalitySite a owl:Class ;
    rdfs:label "HospitalitySite" ;
    rdfs:comment "A catering site (campus, office, hospital, etc.) operated by the Hospitality Group" .

hosp:Product a owl:Class ;
    rdfs:label "Product" ;
    rdfs:comment "A food or beverage product sold at a site" .

