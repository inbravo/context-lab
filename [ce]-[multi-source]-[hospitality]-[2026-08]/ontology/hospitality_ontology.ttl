    hosp:contractedPriceGBP 0.45 ;
    hosp:eposItemId "EPOS-WATER" ;
    hosp:procProductId "PROD-BEV-004" ;
    hosp:productName "Coca-Cola Still Water — 500ml" .

<http://hospitality.example.org/instance/product/prod_bev_005> a hosp:Product ;
    rdfs:label "Tropicana Orange Juice — 330ml" ;
    hosp:category "COLD DRINKS" ;
