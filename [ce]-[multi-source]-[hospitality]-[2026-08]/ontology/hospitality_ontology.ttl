    hosp:eposItemId "EPOS-OJ" ;
    hosp:procProductId "PROD-BEV-005" ;
    hosp:productName "Tropicana Orange Juice — 330ml" .

<http://hospitality.example.org/instance/product/prod_main_001> a hosp:Product ;
    rdfs:label "Chicken Curry & Basmati Rice — portion" ;
    hosp:category "MAINS" ;
    hosp:contractedPriceGBP 3.8 ;
    hosp:eposItemId "EPOS-CCURRY" ;
